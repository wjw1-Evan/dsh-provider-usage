{
  "name": "dsh-multi-provider-usage",
  "version": "0.7.6",
  "description": "DSH (DeepSeek Harness) plugin: one collapsible sidebar widget for OpenCode GO, Command Code and GLM Code Plan quotas plus top-up balances, a periodic balance-change animation, automatic checkout and installed-package updates, same-origin usage proxies, a Plugins-panel settings page and a /provider-usage chat command (DSH 0.1.7+ and 0.2.0 compatible)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "command-code",
    "commandcode",
    "glm",
    "zai",
    "bigmodel",
    "balance",
    "usage",
    "quota",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjw1-Evan/dsh-provider-usage.git"
  },
  "bugs": {
    "url": "https://github.com/wjw1-Evan/dsh-provider-usage/issues"
  },
  "homepage": "https://github.com/wjw1-Evan/dsh-provider-usage#readme"
}
